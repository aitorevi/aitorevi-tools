{
  "name": "aitorevi-tools",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Hub de mini-herramientas web que corren 100% en el navegador.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node serve.mjs",
    "vendor:json-schema": "esbuild vendor/json-schema/entry.js --bundle --minify --format=iife --global-name=JsonSchema --legal-comments=none --banner:js='/*! @cfworker/json-schema 4.1.6 (MIT) + JSON Schema metaschemas (BSD-3-Clause) */' --footer:js='self.JsonSchema=JsonSchema;' --outfile=vendor/json-schema.min.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.6",
    "@keeratita/heic-converter": "0.5.2",
    "@playwright/test": "^1.49.1",
    "esbuild": "^0.28.1",
    "fast-xml-parser": "^5.8.0",
    "smol-toml": "^1.9.1",
    "vitest": "^5.0.5"
  }
}
